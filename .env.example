# ===== Vercel Environment Variables =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=https://niharika.vercel.app
ADMIN_PATH=            # গোপন পাথ, যেমন nx-ctrl-8f3k92 (অনুমানযোগ্য কিছু নয়)
SESSION_SECRET=        # ৩২+ অক্ষরের র‍্যান্ডম লেখা
ADMIN_SETUP_CODE=      # প্রথম অ্যাডমিন বানানোর সময় লাগবে, পরে মুছে দিতে পারেন
REVALIDATE_SECRET=     # র‍্যান্ডম লেখা (GitHub Secrets-এও একই মান)
GOOGLE_SITE_VERIFICATION=   # Search Console এর কোড (ঐচ্ছিক)

# ===== GitHub Secrets (Settings > Secrets and variables > Actions) =====
# উপরের SUPABASE_SERVICE_ROLE_KEY, SITE_URL, REVALIDATE_SECRET একই মানে, আর:
SUPABASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_USER_ID=
